# Copia este archivo y renómbralo como ".env" dentro de la carpeta servidor.
# Luego reemplaza los valores de ejemplo con tus datos reales de Supabase
# (Project Settings > Database > Connection string).
#
# IMPORTANTE: el archivo ".env" nunca se sube a GitHub (ya está en .gitignore).
# Pide la contraseña real al equipo por un medio privado (WhatsApp, Discord, etc.),
# nunca la compartan dentro del código.

DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA_AQUI@db.XXXXXXXXXXXX.supabase.co:5432/postgres
JWT_SECRET=pon_aqui_una_frase_larga_y_secreta