# Copia este archivo como servidor/.env.test y usa SOLO una base de datos
# separada para las pruebas. No subas el archivo real ni compartas sus claves.
TEST_DATABASE_URL=postgresql://usuario:contrasena@host:5432/base_de_pruebas

# Déjalo en true para Supabase. Usa false si PostgreSQL local no usa SSL.
TEST_DATABASE_SSL=true
